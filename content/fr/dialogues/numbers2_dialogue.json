    { "speaker": "A", "text": "Quel âge as-tu ?", "translation": "Firy taona ianao?", "highlight": "âge" },
    { "speaker": "B", "text": "J'ai douze ans.", "translation": "Roambin'ny folo taona aho.", "highlight": "douze" },
    { "speaker": "A", "text": "Et ton frère ?", "translation": "Ary ny anadahinao?", "highlight": "frère" },
    { "speaker": "B", "text": "Il a quinze ans.", "translation": "Dimy ambin'ny folo taona izy.", "highlight": "quinze" },
    { "speaker": "A", "text": "Très bien !", "translation": "Tsara be!", "highlight": "Très bien" }
  ]
