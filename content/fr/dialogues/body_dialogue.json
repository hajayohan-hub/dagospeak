  "lines": [
    { "speaker": "A", "text": "Montrez-moi votre tête.", "translation": "Asehoy ahy ny lohanao.", "highlight": "tête" },
    { "speaker": "B", "text": "Voici ma tête.", "translation": "Ity ny lohako.", "highlight": "tête" },
    { "speaker": "A", "text": "Et vos yeux ?", "translation": "Ary ny masonao?", "highlight": "yeux" },
    { "speaker": "B", "text": "Voici mes yeux.", "translation": "Ity ny masoko.", "highlight": "yeux" },
    { "speaker": "A", "text": "Très bien ! Montrez-moi vos mains.", "translation": "Tsara be ! Asehoy ahy ny tànanao.", "highlight": "mains" },
    { "speaker": "B", "text": "Voici mes mains.", "translation": "Ity ny tànako.", "highlight": "mains" },
    { "speaker": "A", "text": "Parfait ! Vous connaissez votre corps !", "translation": "Tena tsara ! Fantatrao ny vatanao !", "highlight": "corps" }
  ]
}