    { "speaker": "A", "text": "Combien font trois et deux ?", "translation": "Inona no telo sy roa?" },
    { "speaker": "B", "text": "Trois et deux font cinq.", "translation": "Telo sy roa dia dimy." },
    { "speaker": "A", "text": "Très bien ! Et quatre plus trois ?", "translation": "Tsara be ! Ary efatra sy telo?" },
    { "speaker": "B", "text": "Quatre plus trois font sept.", "translation": "Efatra sy telo dia fito." },
    { "speaker": "A", "text": "Maintenant, dix moins quatre ?", "translation": "Ankehitriny, folo efatra?" },
    { "speaker": "B", "text": "Dix moins quatre font six.", "translation": "Folo efatra dia enina." },
    { "speaker": "A", "text": "Excellent ! Vous savez compter jusqu'à dix !", "translation": "Tsara be ! Mahay mitisa hatramin'ny folo ianao !" }
