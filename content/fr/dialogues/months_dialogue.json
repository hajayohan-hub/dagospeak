{
  "id": "months_dialogue",
  "level": "A0",
  "theme": "months",
  "title": "Quel mois sommes-nous ?",
  "titleMg": "Inona ny volana anio?",
  "participants": {
    "A": { "name": "Marie", "avatar": "👩🏼" },
    "B": { "name": "Pierre", "avatar": "👨🏻" }
  },
  "lines": [
    { "speaker": "A", "text": "En quel mois sommes-nous ?", "translation": "Inona ny volana anio?", "highlight": "mois" },
    { "speaker": "B", "text": "Nous sommes en janvier.", "translation": "Janoary anio.", "highlight": "janvier" },
    { "speaker": "A", "text": "Quel est ton mois préféré ?", "translation": "Inona ny volana ankafizinao?", "highlight": "préféré" },
    { "speaker": "B", "text": "Mon mois préféré est décembre.", "translation": "Desambra no volana ankafiziko.", "highlight": "décembre" },
    { "speaker": "A", "text": "Pourquoi décembre ?", "translation": "Nahoana ny desambra?", "highlight": "Pourquoi" },
    { "speaker": "B", "text": "Parce que c'est Noël et les vacances !", "translation": "Satria Krismasy sy fialan-tsasatra !", "highlight": "Noël" },
    { "speaker": "A", "text": "Moi, j'aime juillet pour la plage.", "translation": "Izaho, tiako ny jolay ho an'ny morontsiraka.", "highlight": "juillet" }
  ]
}