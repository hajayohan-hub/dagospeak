    { "speaker": "A", "text": "Bonjour !", "translation": "Manahoana !" },
    { "speaker": "B", "text": "Bonjour ! Comment allez-vous ?", "translation": "Manahoana ! Manahoana ianao?" },
    { "speaker": "A", "text": "Je vais bien, merci. Et vous ?", "translation": "Tsara aho, misaotra. Ary ianao?" },
    { "speaker": "B", "text": "Je vais bien aussi. Merci !", "translation": "Tsara aho koa. Misaotra !" },
    { "speaker": "A", "text": "Au revoir et bonne journée !", "translation": "Veloma ary andro tsara !" },
    { "speaker": "B", "text": "Au revoir !", "translation": "Veloma !" }
