        "ttsTextFr": "Vous cherchez la gare. Comment demandez-vous ?",
        "ttsRate": 0.9
      },
      "nextNode": "user_direction"
    },
    {
      "id": "user_direction",
      "speaker": "user",
      "responseOptions": [
